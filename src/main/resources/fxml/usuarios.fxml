<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox alignment="TOP_CENTER" spacing="20" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.parkingoffice.controller.UsuariosController" stylesheets="@../css/styles.css" style="-fx-padding: 20px;">
    <Label text="Gestión de Usuarios" styleClass="label-header"/>

    <HBox spacing="10">
        <Button text="NUEVO USUARIO" onAction="#nuevoUsuario" styleClass="button-success"/>
        <Button fx:id="btnEliminar" text="ELIMINAR" onAction="#eliminarUsuario" styleClass="button-danger" disable="true"/>
    </HBox>

    <TableView fx:id="tblUsuarios" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
            <TableColumn fx:id="colUsername" text="Usuario" prefWidth="120"/>
            <TableColumn fx:id="colNombre" text="Nombre Completo" prefWidth="200"/>
            <TableColumn fx:id="colRol" text="Rol" prefWidth="130"/>
            <TableColumn fx:id="colActivo" text="Activo" prefWidth="70"/>
        </columns>
    </TableView>

    <VBox fx:id="pnlFormulario" spacing="15" styleClass="card" visible="false" managed="false">
        <Label text="Datos del Usuario" styleClass="label-subheader"/>
        <GridPane hgap="15" vgap="10">
            <columnConstraints>
                <ColumnConstraints minWidth="120"/>
                <ColumnConstraints minWidth="200"/>
            </columnConstraints>
            <Label text="Usuario:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="txtUsername" GridPane.rowIndex="0" GridPane.columnIndex="1" styleClass="text-field"/>

            <Label text="Contraseña:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <PasswordField fx:id="txtPassword" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="password-field"/>

            <Label text="Nombre Completo:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <TextField fx:id="txtNombreCompleto" GridPane.rowIndex="2" GridPane.columnIndex="1" styleClass="text-field"/>

            <Label text="Rol:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <ComboBox fx:id="cmbRol" GridPane.rowIndex="3" GridPane.columnIndex="1" maxWidth="Infinity" styleClass="text-field"/>

            <Label text="Activo:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
            <CheckBox fx:id="chkActivo" selected="true" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
        </GridPane>
        <Label fx:id="lblMensaje" styleClass="label-error" wrapText="true"/>
        <HBox spacing="10">
            <Button text="GUARDAR" onAction="#guardarUsuario" styleClass="button-primary"/>
            <Button text="CANCELAR" onAction="#cancelarEdicion" styleClass="button-danger"/>
        </HBox>
    </VBox>
</VBox>
